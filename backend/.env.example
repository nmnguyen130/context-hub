# Core
ENVIRONMENT=development
PROJECT_NAME=ContextHub
API_V1_STR=/api/v1
ALLOWED_ORIGINS=*

# Secrets
JWT_SECRET=
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=

# Database
POSTGRES_OWNER_USER=postgres
POSTGRES_APP_USER=contexthub_app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=contexthub
# Override these directly in production (from secrets manager):
# DATABASE_URL=postgresql+asyncpg://contexthub_app:***@host:5432/contexthub?ssl=require
# DATABASE_OWNER_URL=postgresql+asyncpg://postgres:***@host:5432/contexthub?ssl=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_SSL_MODE=prefer

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=contexthub

# AI Providers
GEMINI_API_KEY=
COHERE_API_KEY=
